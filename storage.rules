rules_version = '2';

// Scan files: maps/{mapId}/scans/{scanId}/{file}. Readable by anyone with a role on the map,
// writable by owners and editors. Roles are read from Firestore (cross-service rules).
service firebase.storage {
  match /b/{bucket}/o {
    function mapData(mapId) {
      return firestore.get(/databases/(default)/documents/maps/$(mapId)).data;
    }

    function orgRole(orgId) {
      return orgId == null ? null
        : firestore.get(/databases/(default)/documents/orgs/$(orgId)).data.members.get(request.auth.uid, null);
    }

    function role(mapId) {
      let data = mapData(mapId);
      let direct = data.members.get(request.auth.uid, null);
      let viaOrg = orgRole(data.get('orgId', null));
      return direct != null ? direct
        : viaOrg == 'owner' || viaOrg == 'editor' ? 'editor'
        : viaOrg == 'navigator' ? 'navigator'
        : null;
    }

    match /maps/{mapId}/scans/{scanId}/{file} {
      allow read: if request.auth != null && role(mapId) != null;
      allow write: if request.auth != null && role(mapId) in ['owner', 'editor']
        && request.resource.size < 60 * 1024 * 1024
        && file.matches('(roomJson|usdz|worldMap|mesh)\\.[a-z]+');
      allow delete: if request.auth != null && role(mapId) in ['owner', 'editor'];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
