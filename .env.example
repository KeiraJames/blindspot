# Firebase web config (Project settings → Your apps → Web app). Leave blank to run in local-only mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to talk to the local Firebase emulators.
VITE_FIREBASE_EMULATORS=false

# Region the Cloud Functions are deployed to (used for the TTS proxy URL).
VITE_FUNCTIONS_REGION=us-central1
# ElevenLabs voice used for every prompt (one consistent guide voice).
VITE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
