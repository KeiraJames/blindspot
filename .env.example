# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# ElevenLabs natural voice. Use the API key itself (starts with sk_), not the key ID.
# It is built into the app, so keep builds with a key on your own devices only.
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=

# Development only: set to "true" to use the simulated scanner in a production web build.
VITE_ENABLE_SCAN_SIMULATOR=false
