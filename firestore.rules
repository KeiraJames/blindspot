rules_version = '2';

// Roles: owner > editor > navigator. A map's role comes from map.members[uid], or from the
// user's role in the map's organization (org owner/editor → map editor, org navigator →
// navigator). Server-only fields (latestVersion, orgMemberUids, version status) are written
// by Cloud Functions with the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function orgRole(orgId) {
      return orgId == null ? null
        : get(/databases/$(database)/documents/orgs/$(orgId)).data.members.get(uid(), null);
    }

    function mapRoleFrom(data) {
      let direct = data.members.get(uid(), null);
      let viaOrg = orgRole(data.get('orgId', null));
      return direct != null ? direct
        : viaOrg == 'owner' || viaOrg == 'editor' ? 'editor'
        : viaOrg == 'navigator' ? 'navigator'
        : null;
    }

    function mapRole(mapId) {
      return mapRoleFrom(get(/databases/$(database)/documents/maps/$(mapId)).data);
    }

    function canRead(mapId) {
      return signedIn() && mapRole(mapId) != null;
    }

    function canEdit(mapId) {
      return signedIn() && mapRole(mapId) in ['owner', 'editor'];
    }

    function validRoles(members) {
      return members.values().toSet().difference(['owner', 'editor', 'navigator'].toSet()).size() == 0;
    }

    function smallString(s, max) {
      return s is string && s.size() <= max;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['displayName', 'prefs', 'orgIds']);
    }

    match /orgs/{orgId} {
      allow read: if signedIn() && uid() in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.members == {(uid()): 'owner'}
        && request.resource.data.memberUids == [uid()]
        && smallString(request.resource.data.name, 120);
      // Owners manage the org; membership changes go through acceptInvite for everyone else.
      allow update: if signedIn() && resource.data.members.get(uid(), null) == 'owner'
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberUids.toSet() == request.resource.data.members.keys().toSet()
        && validRoles(request.resource.data.members)
        && request.resource.data.members.get(resource.data.ownerId, null) == 'owner';
      allow delete: if signedIn() && resource.data.ownerId == uid();
    }

    match /maps/{mapId} {
      allow read: if signedIn() && (
        uid() in resource.data.memberUids
        || uid() in resource.data.get('orgMemberUids', [])
        || mapRoleFrom(resource.data) != null);

      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.members == {(uid()): 'owner'}
        && request.resource.data.memberUids == [uid()]
        && request.resource.data.latestVersion == null
        && !('orgMemberUids' in request.resource.data)
        && !('versionCounter' in request.resource.data)
        && smallString(request.resource.data.name, 120)
        && (request.resource.data.orgId == null || orgRole(request.resource.data.orgId) in ['owner', 'editor']);

      // Editors: rename, bump the version counter (only by one, in the publish transaction).
      allow update: if canEdit(mapId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'description', 'updatedAt', 'versionCounter'])
        && smallString(request.resource.data.name, 120)
        && (!('versionCounter' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.versionCounter == resource.data.get('versionCounter', 0) + 1);

      // Owners: also membership and organization. The owner can't be removed or demoted.
      allow update: if signedIn() && resource.data.members.get(uid(), null) == 'owner'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'description', 'updatedAt', 'members', 'memberUids', 'orgId', 'versionCounter'])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.members.get(resource.data.ownerId, null) == 'owner'
        && request.resource.data.memberUids.toSet() == request.resource.data.members.keys().toSet()
        && validRoles(request.resource.data.members)
        && (request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
            || request.resource.data.get('orgId', null) == null
            || orgRole(request.resource.data.orgId) in ['owner', 'editor']);

      allow delete: if signedIn() && resource.data.ownerId == uid();

      match /draft/{docId} {
        allow read: if canEdit(mapId);
        allow write: if canEdit(mapId) && docId == 'current'
          && request.resource.data.keys().hasOnly(['graphJson', 'updatedBy', 'updatedAt'])
          && request.resource.data.updatedBy == uid()
          && request.resource.data.graphJson is string;
      }

      // Immutable published versions. Clients create them as "pending"; the validateVersion
      // function marks them valid/invalid and moves the map's latestVersion.
      match /versions/{versionId} {
        allow read: if canRead(mapId);
        allow create: if canEdit(mapId)
          && request.resource.data.keys().hasOnly(['number', 'note', 'graphJson', 'createdBy', 'createdAt', 'status'])
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == uid()
          && request.resource.data.graphJson is string
          && smallString(request.resource.data.note, 500)
          && request.resource.data.number == getAfter(/databases/$(database)/documents/maps/$(mapId)).data.versionCounter
          && int(versionId) == request.resource.data.number;
        allow update, delete: if false;
      }

      match /scans/{scanId} {
        allow read: if canRead(mapId);
        allow create, update: if canEdit(mapId)
          && request.resource.data.createdBy == uid()
          && request.resource.data.resultJson is string;
        allow delete: if canEdit(mapId);
      }
    }

    // Invites and usage counters are server-only (callable functions).
    match /invites/{code} {
      allow read, write: if false;
    }
    match /usage/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow write: if false;
    }
  }
}
